# Only project-related files are tracked: backend, frontend, docs/images, docker-compose, README, start.ps1.
*
!.gitignore
!docker-compose.yml
!README.md
!start.ps1
!backend/
!backend/**
!frontend/
!frontend/**
# README screenshots only; the rest of docs/ stays local.
!docs/
!docs/images/
!docs/images/**

# Secrets and local configuration.
.env
.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# Dependencies, caches, generated files, and local data.
**/node_modules/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/dist/
**/build/
**/.vite/
**/*.tsbuildinfo
**/*.egg-info/
**/*.db
**/*.sqlite3
**/venv/
**/.venv/
backend/data/
backend/chroma_db/
backend/uploads/

# Raw evaluation datasets (re-download with backend/scripts/setup_flashrag_eval.py).
backend/evaluation/flashrag/**/test.jsonl
backend/evaluation/**/raw/

# Local tooling and operating-system files.
.vscode/
.idea/
.codex/
.pi/
.agents/
.claude/
.codebuddy/
.worktrees/
.codegraph/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
